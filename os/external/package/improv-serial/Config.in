config BR2_PACKAGE_IMPROV_SERIAL
	bool "improv-serial"
	depends on BR2_PACKAGE_PYTHON3
	select BR2_PACKAGE_PYTHON_SERIAL
	help
	  Wifi provisioning daemon implementing the Improv Wi-Fi Serial
	  protocol (https://www.improv-wifi.com) on /dev/ttyGS1 (the USB0
	  composite gadget's second CDC ACM function). Writes received
	  credentials to /data/wifi and hands over to wpa_supplicant. Unlike
	  improv-ble, keeps running permanently so credentials can be
	  replaced at any time, not just during initial setup.
