#!/bin/sh
# openmower-cli is a shiv-built Python zipapp: on first run per SHIV_ROOT,
# it unpacks its bundled site-packages there and reuses the extraction on
# later runs. Its own default (unset SHIV_ROOT) is $HOME/.shiv, i.e.
# /root/.shiv for the root user -- but /root is on the read-only squashfs,
# so that mkdir fails ("Read-only file system: '/root/.shiv'") on every
# invocation.
#
# Redirect it to /var (tmpfs, RAM, wiped every boot -- see /etc/fstab), not
# /data: an update replaces this whole squashfs slot, openmower.pyz
# included, but wouldn't touch a persisted extraction cache left over from
# the OLD version on /data -- shiv would then either reuse stale extracted
# code under the new zipapp, or the two could just disagree, depending on
# exactly how it keys the cache. Not worth relying on either way: /var
# means every boot re-extracts fresh from whatever openmower.pyz actually
# ships in that slot, matching it by construction, at the cost of paying
# the (cheap, one-time-per-boot) extraction again after every reboot.
export SHIV_ROOT=/var/cache/openmower-shiv
exec /usr/lib/openmower/openmower.pyz "$@"
