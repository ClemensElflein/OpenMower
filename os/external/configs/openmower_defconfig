# OpenMower OS — unified image, Raspberry Pi CM4 (BCM2711) + CM5 (BCM2712)
#
# One rootfs boots on either board, mirroring how stock Raspberry Pi OS
# ships a single SD image across Pi generations: the Pi firmware
# auto-selects the kernel file (kernel8.img vs kernel_2712.img) and DTB by
# SoC/board revision when config.txt leaves kernel=/device_tree= unset (see
# rootfs-overlay/etc/openmower/config.txt.default), and this build's own
# toolchain is tuned to cortex-a53 (ARMv8.0-A baseline, same ISA level as
# CM4's cortex-a72) rather than CM5's cortex-a76 (ARMv8.2-A) specifically,
# so the resulting userland runs correctly on both CPUs — a76-tuned code
# can use ISA extensions (e.g. LSE atomics) that SIGILL on a72.
#
# BR2_LINUX_KERNEL=n here on purpose: Buildroot only ever builds one kernel
# per output tree, so the two real kernels (one per board) come from two
# separate satellite builds instead — openmower_kernel-cm4_defconfig and
# openmower_kernel-cm5_defconfig, each its own output-kernel-cm4//
# output-kernel-cm5/ tree (see build.sh) — and this build's post-build.sh/
# post-image.sh splice their Image/DTBs/lib-modules output in directly.
# Runtime hardware identity (which of the two boards is actually running)
# is resolved at boot by openmower-detect-hardware, not at build time.

# Architecture / toolchain
BR2_aarch64=y
BR2_cortex_a53=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_AARCH64_GLIBC_STABLE=y
BR2_CCACHE=y
BR2_CCACHE_DIR="/work/os/.cache/ccache"
# docker-engine/docker-cli/containerd/runc (below) pull in host-go, which
# defaults to building the Go compiler itself from C source through 5
# bootstrap stages (host-go-src) -- ~175s on every build, none of it
# ccache-eligible (Go's own build system explicitly opts out, see
# go-bootstrap-stage3.mk's HOSTCC_NOCCACHE) since it's compiling the
# compiler, not something GOCACHE (which only covers actual `go build`
# invocations, i.e. building WITH Go, not building Go itself) helps with
# either. host-go-bin instead downloads the official prebuilt release
# straight from go.dev/dl -- same toolchain, officially supported choice
# in buildroot's own Kconfig (package/go/Config.in.host), and the download
# goes through BR2_DL_DIR like anything else, so it's cached across builds
# same as everything else here.
BR2_PACKAGE_HOST_GO_BIN=y
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_ROOTFS_DEVICE_TABLE="system/device_table.txt $(BR2_EXTERNAL_OPENMOWER_PATH)/board/openmower/device_table.txt"

# System
BR2_INIT_SYSTEMD=y
BR2_TARGET_GENERIC_HOSTNAME="openmower"
BR2_TARGET_GENERIC_ISSUE="OpenMower OS"
# Development root password — production images must switch to key-only auth.
BR2_TARGET_GENERIC_ROOT_PASSWD="openmower"
BR2_SYSTEM_DEFAULT_PATH="/usr/sbin:/usr/bin:/sbin:/bin"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_OPENMOWER_PATH)/board/openmower/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_OPENMOWER_PATH)/board/openmower/post-build.sh"
BR2_ROOTFS_POST_FAKEROOT_SCRIPT="$(BR2_EXTERNAL_OPENMOWER_PATH)/board/openmower/post-fakeroot.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_OPENMOWER_PATH)/board/openmower/post-image.sh"

# No kernel built in this tree -- see header comment. rpi-firmware's DTB
# install still needs wiring explicitly though: BR2_PACKAGE_RPI_FIRMWARE_
# INSTALL_DTB_OVERLAYS depends on (INSTALL_DTBS || BR2_LINUX_KERNEL_DTS_
# SUPPORT), and DTS_SUPPORT doesn't exist in this build at all (no kernel),
# so INSTALL_DTBS=y is the only way to satisfy that OR. The DTBs it
# actually installs this way come from the *firmware* blob repo, wrong
# kernel version for our fork -- post-build.sh deletes them and replaces
# them with the real ones copied in from both kernel satellite builds.
BR2_PACKAGE_RPI_FIRMWARE_INSTALL_DTBS=y

# Firmware / boot
BR2_PACKAGE_RPI_FIRMWARE=y
# start4.elf/fixup4.dat -- CM4's VideoCore boot stage only; CM5 has no
# such stage (ARM boot ROM + EEPROM reads config.txt directly) and no
# firmware "variant" flag of its own in this buildroot version at all, so
# nothing extra is needed on its side.
BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI4=y
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_OPENMOWER_PATH)/board/openmower/rootfs-overlay/etc/openmower/config.txt.default"
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_WIFI=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_BT=y

# Hardware support
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y

# Networking
BR2_PACKAGE_IW=y
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_PACKAGE_WPA_SUPPLICANT_CTRL_IFACE=y
# DHCP server for the internal CM4/CM5<->xCore link (172.16.78.0/24), and
# (feature/usb-device-mode) now also serving br0 (eth0 + the USB gadget's
# usb0 ethernet function bridged together) -- see rootfs-overlay/etc/
# dnsmasq.conf, 15-br0.netdev/20-ethernet.network/21-usb-ethernet.network
# and dnsmasq.service.
BR2_PACKAGE_DNSMASQ=y
# BR2_PACKAGE_DNSMASQ_TFTP is not set
BR2_PACKAGE_DNSMASQ_DHCP=y
BR2_PACKAGE_DROPBEAR=y
# Packet capture for diagnosing the bridged eth0/USB-gadget network
# (feature/usb-device-mode).
BR2_PACKAGE_TCPDUMP=y

# System resolver. Without this, /etc/resolv.conf is never populated at all
# (systemd's own systemd.mk only installs the ../run/systemd/resolve/
# resolv.conf symlink under this option) -- every hostname lookup on-device
# fails, docker pulls included ("dial tcp: lookup ...: no such host"),
# confirmed the hard way against real hardware. dnsmasq.conf's own comment
# ("DNS itself stays with systemd-resolved") and resolved.conf.d/10-mdns.conf
# already assumed this was on; it never actually was.
BR2_PACKAGE_SYSTEMD_RESOLVED=y

# Bluetooth (Improv provisioning)
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ5_UTILS_TOOLS=y

# OTA
BR2_PACKAGE_RAUC=y
BR2_PACKAGE_RAUC_DBUS=y
BR2_PACKAGE_HOST_RAUC=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_LIBCURL_OPENSSL=y
BR2_PACKAGE_CA_CERTIFICATES=y

# Provisioning daemon runtime
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_SSL=y
BR2_PACKAGE_PYTHON_DBUS_FAST=y
# zipapp/zipfile support (zlib) -- without it, Python can't open compressed
# zip members at all, which breaks any shiv-built zipapp, openmower-cli
# included ("no zlib" at runtime, confirmed against real hardware).
BR2_PACKAGE_PYTHON3_ZLIB=y

# Interactive login shell for root (see post-build.sh + rootfs-overlay/
# root/.bashrc) -- boot-critical scripts stay POSIX sh regardless, this is
# purely so SSH'ing in feels like stock Raspberry Pi OS.
BR2_PACKAGE_BASH=y

# Filesystem tools
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_FSCK=y
# resize2fs -- openmower-expand-data grows /data's filesystem to fill the
# real disk on first boot (see rootfs-overlay/usr/bin/openmower-expand-data).
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y

# sfdisk + partx -- same first-boot data-partition grow: sfdisk rewrites
# the partition table entry, partx updates the running kernel's view of it
# while /data stays mounted (unlike a full blockdev --rereadpt).
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_PARTX=y

# Diagnostics tools (buildroot subset).
BR2_PACKAGE_SOCAT=y
BR2_PACKAGE_PYTHON_SERIAL=y
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_NANO=y
BR2_PACKAGE_MC=y
# wavemon selects BR2_PACKAGE_LIBNL_TOOLS itself (libnl's cli sub-lib,
# needed for its wifi survey view).
BR2_PACKAGE_WAVEMON=y
# vcgencmd -- see external/package/vcgencmd -- SoC temp/voltage/clock/
# throttling readout. Not the GL/EGL/OpenMAX/MMAL/raspicam side of
# raspberrypi/userland (upstream's own CMakeLists skips all that on
# aarch64), and not rpi-config or anything that rewrites config.txt.
BR2_PACKAGE_VCGENCMD=y

# SWD flashing/debugging of the xCore (LL board MCU) via the CM4/CM5's own
# GPIO -- openmower-cli's firmware uploader shells out to openocd with
# /etc/openocd/xcore.cfg (a boot-time symlink to xcore-cm4.cfg/xcore-cm5.cfg,
# see openmower-detect-hardware), so this is needed on prod too, not just
# dev. Both backends built into the one openocd binary -- bcm2835gpio
# (direct register access, CM4/BCM2711 only) and linuxgpiod (gpiochip
# character device, needed on CM5/BCM2712 since it dropped direct register
# access) are independent, co-selectable configure flags, not mutually
# exclusive.
BR2_PACKAGE_OPENOCD=y
BR2_PACKAGE_OPENOCD_BCM2835=y
BR2_PACKAGE_LIBGPIOD=y

# Lightweight container runtime for openmower.service (see
# external/package/openmower-ros) -- runs the vendored ROS tree via
# systemd-nspawn instead of a hand-rolled RootDirectory= unit; no new
# dependency, just a build flag on the systemd package already in use.
BR2_PACKAGE_SYSTEMD_NSPAWN=y

# Docker + compose for the auxiliary GUI stack only (Mosquitto, OpenMowerApp,
# Dockge, ttyd -- see rootfs-overlay/etc/openmower-stack, /etc/dockge-stack,
# /etc/webterminal-stack). open_mower_ros itself stays on systemd-nspawn
# above: it's a single multi-GB payload already carried atomically by RAUC,
# and docker-compose-managing it too would mean pulling+unpacking a second
# copy into /var/lib/docker on top of that plus a second, independent update
# mechanism -- no benefit, real cost. Docker is scoped to the small
# third-party images we don't control the release process for instead.
BR2_PACKAGE_DOCKER_ENGINE=y
BR2_PACKAGE_DOCKER_CLI=y
BR2_PACKAGE_DOCKER_COMPOSE=y

# Own packages
BR2_PACKAGE_IMPROV_BLE=y
# Improv-over-serial: WiFi provisioning via the USB gadget's ttyGS0 console
# port, alongside the existing BLE path (feature/usb-device-mode) -- see
# external/package/improv-serial and openmower-usb-gadget-init.
BR2_PACKAGE_IMPROV_SERIAL=y
BR2_PACKAGE_OPENMOWER_ROS=y
BR2_PACKAGE_OPENMOWER_CLI=y

# Rootfs — read-only squashfs (A/B slots)
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_ZSTD=y
# BR2_TARGET_ROOTFS_TAR is not set

# Host tools for image assembly
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_E2FSPROGS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_KMOD_XZ=y
BR2_PACKAGE_HOST_MTOOLS=y
