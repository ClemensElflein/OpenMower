# OpenMower OS — Raspberry Pi CM4 / Pi 4 (BCM2711, aarch64)
# Derived from buildroot's raspberrypi4_64_defconfig.

# Architecture / toolchain
BR2_aarch64=y
BR2_cortex_a72=y
BR2_ARM_FPU_VFPV4=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_AARCH64_GLIBC_STABLE=y
BR2_CCACHE=y
BR2_CCACHE_DIR="/work/os/.cache/ccache"
# docker-engine/docker-cli/containerd/runc (below) pull in host-go, which
# defaults to building the Go compiler itself from C source through 5
# bootstrap stages (host-go-src) -- ~175s on every build, none of it
# ccache-eligible (Go's own build system explicitly opts out, see
# go-bootstrap-stage3.mk's HOSTCC_NOCCACHE) since it's compiling the
# compiler, not something GOCACHE (which only covers actual `go build`
# invocations, i.e. building WITH Go, not building Go itself) helps with
# either. host-go-bin instead downloads the official prebuilt release
# straight from go.dev/dl -- same toolchain, officially supported choice
# in buildroot's own Kconfig (package/go/Config.in.host), and the download
# goes through BR2_DL_DIR like anything else, so it's cached across builds
# same as everything else here.
BR2_PACKAGE_HOST_GO_BIN=y
BR2_GLOBAL_PATCH_DIR="board/raspberrypi/patches"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_ROOTFS_DEVICE_TABLE="system/device_table.txt $(BR2_EXTERNAL_OPENMOWER_PATH)/board/openmower-cm4/device_table.txt"

# System
BR2_INIT_SYSTEMD=y
BR2_TARGET_GENERIC_HOSTNAME="openmower"
BR2_TARGET_GENERIC_ISSUE="OpenMower OS"
# Development root password — production images must switch to key-only auth.
BR2_TARGET_GENERIC_ROOT_PASSWD="openmower"
BR2_SYSTEM_DEFAULT_PATH="/usr/sbin:/usr/bin:/sbin:/bin"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_OPENMOWER_PATH)/board/openmower-cm4/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_OPENMOWER_PATH)/board/openmower-cm4/post-build.sh"
BR2_ROOTFS_POST_FAKEROOT_SCRIPT="$(BR2_EXTERNAL_OPENMOWER_PATH)/board/openmower-cm4/post-fakeroot.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_OPENMOWER_PATH)/board/openmower-cm4/post-image.sh"

# Kernel — raspberrypi fork, pinned (same as upstream raspberrypi4_64_defconfig)
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="$(call github,raspberrypi,linux,21b410140c47ffab5668399f6f143c7d7b935c8b)/linux-21b410140c47ffab5668399f6f143c7d7b935c8b.tar.gz"
BR2_LINUX_KERNEL_DEFCONFIG="bcm2711"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_OPENMOWER_PATH)/board/openmower-cm4/kernel-fragment.config"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2711-rpi-4-b broadcom/bcm2711-rpi-cm4"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# Firmware / boot
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI4=y
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_OPENMOWER_PATH)/board/openmower-cm4/rootfs-overlay/etc/openmower/config.txt.default"
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_WIFI=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_BT=y

# Hardware support
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y

# Networking
BR2_PACKAGE_IW=y
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_PACKAGE_WPA_SUPPLICANT_CTRL_IFACE=y
# DHCP server for the internal CM4<->xCore link (172.16.78.0/24) -- see
# rootfs-overlay/etc/dnsmasq.conf and dnsmasq.service.
BR2_PACKAGE_DNSMASQ=y
# BR2_PACKAGE_DNSMASQ_TFTP is not set
BR2_PACKAGE_DNSMASQ_DHCP=y
BR2_PACKAGE_DROPBEAR=y

# System resolver. Without this, /etc/resolv.conf is never populated at all
# (systemd's own systemd.mk only installs the ../run/systemd/resolve/
# resolv.conf symlink under this option) -- every hostname lookup on-device
# fails, docker pulls included ("dial tcp: lookup ...: no such host"),
# confirmed the hard way against real hardware. dnsmasq.conf's own comment
# ("DNS itself stays with systemd-resolved") and resolved.conf.d/10-mdns.conf
# already assumed this was on; it never actually was.
BR2_PACKAGE_SYSTEMD_RESOLVED=y

# Bluetooth (Improv provisioning)
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ5_UTILS_TOOLS=y

# OTA
BR2_PACKAGE_RAUC=y
BR2_PACKAGE_RAUC_DBUS=y
BR2_PACKAGE_HOST_RAUC=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_LIBCURL_OPENSSL=y
BR2_PACKAGE_CA_CERTIFICATES=y

# Provisioning daemon runtime
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_SSL=y
BR2_PACKAGE_PYTHON_DBUS_FAST=y
# zipapp/zipfile support (zlib) -- without it, Python can't open compressed
# zip members at all, which breaks any shiv-built zipapp, openmower-cli
# included ("no zlib" at runtime, confirmed against real hardware).
BR2_PACKAGE_PYTHON3_ZLIB=y

# Interactive login shell for root (see post-build.sh + rootfs-overlay/
# root/.bashrc) -- boot-critical scripts stay POSIX sh regardless, this is
# purely so SSH'ing in feels like stock Raspberry Pi OS.
BR2_PACKAGE_BASH=y

# Filesystem tools
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_FSCK=y

# Diagnostics tools (buildroot subset).
# mc dropped: 4.8.33's build hits an ncursesw wide-char detection issue
# under this cross setup (implicit decl of getcchar/setcchar/mvin_wchnstr
# in tty-ncurses.c) despite BR2_PACKAGE_NCURSES_WCHAR=y being correctly
# set. wavemon dropped: 0.9.5 hard-requires libnl-cli-3.0 (configure:
# "need libnl-cli-3.0 >= 3.2"), which buildroot's libnl package has no
# sub-option to build and wavemon.mk doesn't work around. Neither worth
# chasing for optional tools.
BR2_PACKAGE_SOCAT=y
BR2_PACKAGE_PYTHON_SERIAL=y
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_NANO=y
BR2_PACKAGE_MC=y

# SWD flashing/debugging of the xCore (LL board MCU) via the CM4's own GPIO
# -- openmower-cli's firmware uploader shells out to openocd with
# rootfs-overlay/etc/openocd/xcore.cfg, so this is needed on prod too, not
# just dev.
BR2_PACKAGE_OPENOCD=y
BR2_PACKAGE_OPENOCD_BCM2835=y

# Lightweight container runtime for openmower.service (see
# external/package/openmower-ros) -- runs the vendored ROS tree via
# systemd-nspawn instead of a hand-rolled RootDirectory= unit; no new
# dependency, just a build flag on the systemd package already in use.
BR2_PACKAGE_SYSTEMD_NSPAWN=y

# Docker + compose for the auxiliary GUI stack only (Mosquitto, OpenMowerApp,
# Dockge, ttyd -- see rootfs-overlay/etc/openmower-stack, /etc/dockge-stack,
# /etc/webterminal-stack). open_mower_ros itself stays on systemd-nspawn
# above: it's a single multi-GB payload already carried atomically by RAUC,
# and docker-compose-managing it too would mean pulling+unpacking a second
# copy into /var/lib/docker on top of that plus a second, independent update
# mechanism -- no benefit, real cost. Docker is scoped to the small
# third-party images we don't control the release process for instead.
BR2_PACKAGE_DOCKER_ENGINE=y
BR2_PACKAGE_DOCKER_CLI=y
BR2_PACKAGE_DOCKER_COMPOSE=y

# Own packages
BR2_PACKAGE_IMPROV_BLE=y
BR2_PACKAGE_OPENMOWER_ROS=y
BR2_PACKAGE_OPENMOWER_CLI=y

# Rootfs — read-only squashfs (A/B slots)
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_ZSTD=y
# BR2_TARGET_ROOTFS_TAR is not set

# Host tools for image assembly
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_E2FSPROGS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_KMOD_XZ=y
BR2_PACKAGE_HOST_MTOOLS=y
