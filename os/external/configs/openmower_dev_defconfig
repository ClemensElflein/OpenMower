# OpenMower OS — unified image (CM4/CM5) — DEV VARIANT
#
# Same image as openmower_defconfig (identical kernels, rootfs type, A/B
# layout) plus remote-development tooling for CLion: gdbserver (copied
# straight from the external toolchain, version-matched) + a host cross-gdb,
# and openssh (for its sftp-server, which CLion's deployment/sync needs —
# dropbear doesn't ship one) in place of dropbear.
#
# Build/binaries still land on the read-only squashfs root like prod; deploy
# and debug from /data (e.g. /data/dev), which is a real persistent, writable
# partition in this design — no need for a writable rootfs to get a fast
# edit-deploy-debug loop.
#
# Usage: make openmower_dev_defconfig && make
# Switch back to prod: make openmower_defconfig && make

# Architecture / toolchain — see openmower_defconfig's header comment for
# why cortex-a53 (not a72/a76): this is the same unified CM4+CM5 image,
# just with dev tooling layered on.
BR2_aarch64=y
BR2_cortex_a53=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_AARCH64_GLIBC_STABLE=y
# Target gdbserver, copied from the toolchain (version/ABI-matched to its
# libc — avoids building our own and risking a mismatch).
BR2_TOOLCHAIN_EXTERNAL_GDB_SERVER_COPY=y
BR2_CCACHE=y
BR2_CCACHE_DIR="/work/os/.cache/ccache"
# See the prod defconfig's comment -- skips rebuilding the Go compiler from
# source (~175s, not ccache-eligible) on every clean build.
BR2_PACKAGE_HOST_GO_BIN=y
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_ROOTFS_DEVICE_TABLE="system/device_table.txt $(BR2_EXTERNAL_OPENMOWER_PATH)/board/openmower/device_table.txt"

# Host cross-gdb: point CLion's toolchain/debugger setting at
# output/host/bin/aarch64-*-gdb, paired with gdbserver on the target.
BR2_PACKAGE_HOST_GDB=y
BR2_PACKAGE_HOST_GDB_TUI=y
BR2_PACKAGE_HOST_GDB_PYTHON3=y

# System
BR2_INIT_SYSTEMD=y
BR2_TARGET_GENERIC_HOSTNAME="openmower"
BR2_TARGET_GENERIC_ISSUE="OpenMower OS (dev)"
# Development root password — production images must switch to key-only auth.
BR2_TARGET_GENERIC_ROOT_PASSWD="openmower"
BR2_SYSTEM_DEFAULT_PATH="/usr/sbin:/usr/bin:/sbin:/bin"
# Prod overlay first, dev-only additions (ssh host-key persistence, sshd
# drop-in) layered on top — nothing in board/openmower/rootfs-overlay
# itself changes, so prod and dev never drift against each other.
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_OPENMOWER_PATH)/board/openmower/rootfs-overlay $(BR2_EXTERNAL_OPENMOWER_PATH)/board/openmower/rootfs-overlay-dev"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_OPENMOWER_PATH)/board/openmower/post-build.sh"
BR2_ROOTFS_POST_FAKEROOT_SCRIPT="$(BR2_EXTERNAL_OPENMOWER_PATH)/board/openmower/post-fakeroot.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_OPENMOWER_PATH)/board/openmower/post-image.sh"
# Tells the (shared) post-image.sh to add console=ttyS0,115200 (the default
# UART header pins) to cmdline.txt -- see that script's own comment.
BR2_ROOTFS_POST_IMAGE_SCRIPT_ARGS="dev"

# No kernel built in this tree -- see openmower_defconfig's header comment
# and its matching comment on this same option for why INSTALL_DTBS=y is
# required here despite the name suggesting the opposite.
BR2_PACKAGE_RPI_FIRMWARE_INSTALL_DTBS=y

# Firmware / boot
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI4=y
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_OPENMOWER_PATH)/board/openmower/rootfs-overlay/etc/openmower/config.txt.default"
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_WIFI=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_BT=y

# Hardware support
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y

# Networking
BR2_PACKAGE_IW=y
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_PACKAGE_WPA_SUPPLICANT_CTRL_IFACE=y
# DHCP server for the internal CM4/CM5<->xCore link (172.16.78.0/24) -- see
# rootfs-overlay/etc/dnsmasq.conf and dnsmasq.service.
BR2_PACKAGE_DNSMASQ=y
# BR2_PACKAGE_DNSMASQ_TFTP is not set
BR2_PACKAGE_DNSMASQ_DHCP=y
# openssh instead of dropbear: CLion's deployment/sync wants an sftp-server,
# which dropbear doesn't provide.
BR2_PACKAGE_OPENSSH=y

# System resolver. Without this, /etc/resolv.conf is never populated at all
# (systemd's own systemd.mk only installs the ../run/systemd/resolve/
# resolv.conf symlink under this option) -- every hostname lookup on-device
# fails, docker pulls included ("dial tcp: lookup ...: no such host"),
# confirmed the hard way against real hardware. dnsmasq.conf's own comment
# ("DNS itself stays with systemd-resolved") and resolved.conf.d/10-mdns.conf
# already assumed this was on; it never actually was.
BR2_PACKAGE_SYSTEMD_RESOLVED=y

# Bluetooth (Improv provisioning)
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ5_UTILS_TOOLS=y

# OTA
BR2_PACKAGE_RAUC=y
BR2_PACKAGE_RAUC_DBUS=y
BR2_PACKAGE_HOST_RAUC=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_LIBCURL_OPENSSL=y
BR2_PACKAGE_CA_CERTIFICATES=y

# Provisioning daemon runtime
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_SSL=y
BR2_PACKAGE_PYTHON_DBUS_FAST=y
# zipapp/zipfile support (zlib) -- without it, Python can't open compressed
# zip members at all, which breaks any shiv-built zipapp, openmower-cli
# included ("no zlib" at runtime, confirmed against real hardware).
BR2_PACKAGE_PYTHON3_ZLIB=y

# Interactive login shell for root (see post-build.sh + rootfs-overlay/
# root/.bashrc) -- boot-critical scripts stay POSIX sh regardless, this is
# purely so SSH'ing in feels like stock Raspberry Pi OS.
BR2_PACKAGE_BASH=y

# Filesystem tools
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_FSCK=y
# resize2fs -- openmower-expand-data grows /data's filesystem to fill the
# real disk on first boot (see rootfs-overlay/usr/bin/openmower-expand-data).
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y

# sfdisk + partx -- same first-boot data-partition grow: sfdisk rewrites
# the partition table entry, partx updates the running kernel's view of it
# while /data stays mounted (unlike a full blockdev --rereadpt).
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_PARTX=y

# Diagnostics tools (buildroot subset).
# mc dropped: 4.8.33's build hits an ncursesw wide-char detection issue
# under this cross setup (implicit decl of getcchar/setcchar/mvin_wchnstr
# in tty-ncurses.c) despite BR2_PACKAGE_NCURSES_WCHAR=y being correctly
# set. wavemon dropped: 0.9.5 hard-requires libnl-cli-3.0 (configure:
# "need libnl-cli-3.0 >= 3.2"), which buildroot's libnl package has no
# sub-option to build and wavemon.mk doesn't work around. Neither worth
# chasing for optional tools.
BR2_PACKAGE_SOCAT=y
BR2_PACKAGE_PYTHON_SERIAL=y
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_NANO=y
BR2_PACKAGE_MC=y

# Dev tools
BR2_PACKAGE_STRACE=y
# rsync 3.4.3's syscall.c unconditionally #includes <linux/openat2.h> on
# any __linux__ build (no autoconf/feature-test guard, just assumes 5.6+
# headers) -- this toolchain's pinned Bootlin headers are 5.4-series, so it
# fails to compile. Pre-existing, unrelated to CM4/CM5 (toolchain headers
# are fixed by the external toolchain choice, independent of whichever
# kernel actually gets built) -- image-dev isn't in CI, so this may have
# been broken for a while unnoticed. Disabled until either the toolchain's
# headers move to 5.6+ or rsync gets patched to guard that include.
# BR2_PACKAGE_RSYNC is not set
# SWD flashing/debugging of the xCore (LL board MCU) via the CM4/CM5's own
# GPIO -- see rootfs-overlay/etc/openocd/xcore-cm4.cfg/xcore-cm5.cfg. Also
# enabled on prod (see prod defconfig): openmower-cli's firmware uploader
# needs it there too.
BR2_PACKAGE_OPENOCD=y
BR2_PACKAGE_OPENOCD_BCM2835=y
BR2_PACKAGE_LIBGPIOD=y

# Lightweight container runtime for openmower.service (see
# external/package/openmower-ros) -- runs the vendored ROS tree via
# systemd-nspawn instead of a hand-rolled RootDirectory= unit; no new
# dependency, just a build flag on the systemd package already in use.
BR2_PACKAGE_SYSTEMD_NSPAWN=y

# Docker + compose for the auxiliary GUI stack only (Mosquitto, OpenMowerApp,
# Dockge, ttyd -- see rootfs-overlay/etc/openmower-stack, /etc/dockge-stack,
# /etc/webterminal-stack). open_mower_ros itself stays on systemd-nspawn
# above: it's a single multi-GB payload already carried atomically by RAUC,
# and docker-compose-managing it too would mean pulling+unpacking a second
# copy into /var/lib/docker on top of that plus a second, independent update
# mechanism -- no benefit, real cost. Docker is scoped to the small
# third-party images we don't control the release process for instead.
BR2_PACKAGE_DOCKER_ENGINE=y
BR2_PACKAGE_DOCKER_CLI=y
BR2_PACKAGE_DOCKER_COMPOSE=y

# Own packages
BR2_PACKAGE_IMPROV_BLE=y
BR2_PACKAGE_IMPROV_SERIAL=y
BR2_PACKAGE_OPENMOWER_ROS=y
BR2_PACKAGE_OPENMOWER_CLI=y

# Rootfs — read-only squashfs (A/B slots), same as prod
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_ZSTD=y
# BR2_TARGET_ROOTFS_TAR is not set

# Host tools for image assembly
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_E2FSPROGS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_KMOD_XZ=y
BR2_PACKAGE_HOST_MTOOLS=y
