# OpenMower OS — migration initramfs (RPi CM4 / Pi 4, BCM2711, aarch64)
#
# Not a bootable system image and not part of the normal A/B RAUC flow. This
# is a tiny busybox + util-linux initramfs, tryboot'd from a running stock
# Raspberry Pi OS install (see scripts/migrate-to-openmower.sh) to `dd` a
# full openmower-cm4 sdcard.img onto the disk and write the first A/B slot
# -- a one-time bootstrap so a fleet already in the field can move onto this
# RAUC-managed OS entirely over the network, with no SD card removal. The
# sdcard.img itself is fetched by migrate-to-openmower.sh over the network
# at run time, not embedded here (see that script's own header) -- this
# initramfs only ever handles the small, rarely-changing kernel/dtbs/migration
# bits.
#
# Reuses the SAME kernel/dtbs as openmower_cm4_defconfig: mmc, ext4, vfat and
# squashfs are all built into that kernel (see
# board/openmower-cm4/kernel-fragment.config -- "no initrd, must be built
# in"), so this defconfig builds no kernel at all, just rootfs.cpio.gz. Its
# post-image.sh (BR2_ROOTFS_POST_IMAGE_SCRIPT below) pulls the kernel/dtbs
# from a *prior* openmower_cm4_defconfig build's output/images/ and
# assembles them, plus this initramfs, into a single self-extracting
# installer script -- see that file and scripts/migrate-to-openmower.sh for
# the rest of the mechanism.
#
# Own output dir (output-migration/, see build.sh) -- Buildroot has no way to
# prune a disabled package's files back out of target/, so this can't safely
# share output/ with prod (tried it once: produced a rootfs.cpio with the
# entire leftover prod target/ baked in, 5GB+, instead of a few MB).
#
# Usage: make image-migration   (needs a prior `make image`)
#   -> output-migration/images/openmower-migrate-<version>.sh

# Architecture / toolchain (must match openmower_cm4_defconfig -- this
# initramfs runs on the same board under the same kernel)
BR2_aarch64=y
BR2_cortex_a72=y
BR2_ARM_FPU_VFPV4=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_AARCH64_GLIBC_STABLE=y
BR2_CCACHE=y
BR2_CCACHE_DIR="/work/os/.cache/ccache"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y

# System — no init system; our own /init runs as PID1 (an initramfs always
# has the kernel exec /init directly, regardless of init selection) and
# never returns: it partitions the disk and reboots.
BR2_INIT_NONE=y
BR2_TARGET_GENERIC_HOSTNAME="openmower-migration"
BR2_TARGET_GENERIC_ISSUE="OpenMower OS migration"
BR2_SYSTEM_DEFAULT_PATH="/usr/sbin:/usr/bin:/sbin:/bin"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_OPENMOWER_PATH)/board/openmower-cm4-migration/rootfs-overlay"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_OPENMOWER_PATH)/board/openmower-cm4-migration/post-image.sh"

# Tools used by /init (blockdev, blkid come from the "basic set" -- see
# util-linux's Config.in. wipefs is NOT part of that set despite being
# listed in its help text -- that help text is stale/inaccurate; wipefs is
# gated by its own separate Kconfig option). No e2fsprogs: /init no longer
# runs mkfs.ext4 itself -- the data partition comes pre-formatted (empty)
# inside the downloaded sdcard.img -- and mounting ext4 to restore staged
# user data only needs the kernel driver (already built into the shared
# kernel, see above), not e2fsprogs' userspace tools.
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_WIPEFS=y

# Rootfs — CPIO initramfs, gzip (what tryboot.txt's "initramfs ... followkernel" expects)
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
# BR2_TARGET_ROOTFS_TAR is not set
