# Rootfs is squashfs (zstd) mounted directly, no initrd — must be built in.
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y

# Hardware watchdog backs the tryboot rollback (systemd RuntimeWatchdogSec).
CONFIG_WATCHDOG=y
CONFIG_BCM2835_WDT=y

# The RPi defconfig ships the wifi + Bluetooth transport drivers as modules.
# Building them in used to be "needed" because module loading was broken
# (XZ-compressed modules + no in-kernel decompress + kmod without xz =
# finit_module returns ENOSYS) — module compression is disabled below, which
# fixes that generically.
#
# Both brcmfmac (SDIO) and hci_uart (serdev) must NOT be built in: a built-in
# driver probes synchronously during early kernel init, before the root
# device (holding /lib/firmware) has even been enumerated, so its firmware
# request fails with ENOENT and the chip never comes up. Confirmed via dmesg
# for wifi (firmware ENOENT at ~1.4s, mmcblk0/root not detected until ~1.5s,
# brcmfmac then stuck in "HT Avail timeout") and via the exact same failure
# mode on Bluetooth (hci0 exported but never fully initialized, improv-ble
# stuck in an infinite InterfaceNotFoundError retry loop waiting on an
# adapter that never finishes coming up).
#
# SDIO devices get udev MODALIAS hotplug autoload, so brcmfmac needs nothing
# extra. Serdev has no such hotplug path (nothing generates a MODALIAS uevent
# for it), so hci_uart is loaded explicitly post-boot via
# etc/modules-load.d/bluetooth.conf in the rootfs overlay — by then root
# (and /lib/firmware) is mounted, so its firmware load race is gone too.
CONFIG_RFKILL=y
CONFIG_CFG80211=m
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_SDIO=y

# Core Bluetooth protocol stack: no hardware probing/firmware loading of its
# own, so no timing hazard — stays built in.
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_BCM=y
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y

# Transport driver: built as a module, loaded post-boot (see comment above).
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_BCM=y

# Don't compress modules: this kernel has no MODULE_DECOMPRESS and the target
# kmod is built without xz, so compressed modules cannot be loaded at all.
# CONFIG_MODULE_COMPRESS_XZ is not set
# CONFIG_MODULE_COMPRESS is not set

# Fully preemptible kernel: this is a 6.12 kernel (mainline PREEMPT_RT merge),
# arm64 unconditionally selects ARCH_SUPPORTS_RT, and CONFIG_EXPERT is already
# on — so no extra dependency work needed. Tightens scheduling latency for
# the mower's control loop (comms/motor control timing).
CONFIG_PREEMPT_RT=y

# USB0 dual-role (OTG): the carrier board wires USB0 through a hardware mux
# to either an external (device-facing) connector or an internal USB host
# connector, selected by the mux's own cable-detect circuit, which also
# drives USB_OTG_ID (CM4 edge connector pin 101 -- same pin the official
# CM4 IO board breaks out) back into the SoC's own dwc2 OTG ID-pin
# comparator. So dwc2 must support BOTH host and gadget electrically and
# switch between them at runtime (not be hardwired to one mode), and can do
# so entirely on its own: a Connector ID Status Change interrupt drives
# dwc2_conn_id_status_change() (drivers/usb/dwc2/hcd.c) straight into
# host/device mode with no software role switch or userspace cable-detect
# polling involved -- config.txt's `dtoverlay=dwc2,dr_mode=otg` is the only
# other piece needed. bcm2711_defconfig already builds dwc2 this way
# (USB_DWC2=y, USB_GADGET=y -> DUAL_ROLE is the Kconfig choice default),
# pinned explicitly here so that never silently regresses.
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_DUAL_ROLE=y
# CONFIG_USB_DWC2_HOST is not set
# CONFIG_USB_DWC2_PERIPHERAL is not set

# ConfigFS composite USB gadget (CDC ACM x2 + CDC NCM) -- see
# rootfs-overlay's openmower-usb-gadget-init, which only ever instantiates
# acm.usb0/acm.usb1/ncm.usb0. Deliberately NOT the legacy monolithic
# g_serial/g_ether gadget drivers: those can only expose one function
# each, we need three simultaneously in one composite device. ECM/RNDIS
# (alternative USB-Ethernet gadget functions, on by default in
# bcm2711_defconfig) are left out -- openmower-usb-gadget-init picked NCM
# over both, and never creates an ecm.*/rndis.* function.
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=m
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_F_ACM=m
CONFIG_USB_F_NCM=m
CONFIG_USB_U_ETHER=m

# Unlike the other gadget bits above, U_SERIAL must be BUILT IN (not a
# module): U_SERIAL_CONSOLE is a bool that "depends on USB_U_SERIAL", and
# Kconfig will not let a bool=y depend on a tristate=m (a "y" symbol can't
# depend on an "m" one) -- so U_SERIAL_CONSOLE is simply unselectable while
# USB_U_SERIAL=m, no error, it just silently stays off. This is what makes
# ttyGS0 (acm.usb0, the first serial function created) register itself as
# a genuine kernel console the moment openmower-usb-gadget-init creates it
# (gserial_alloc_line() auto-enables console for port_num 0), with
# CON_PRINTBUFFER replaying the existing dmesg ring buffer to it so a host
# that's already attached at that point sees the boot log retroactively.
# Genuinely early (pre-userspace) kernel messages still can't reach it --
# ConfigFS gadgets can only be assembled from userspace, after root is
# mounted -- this is the closest a ConfigFS-based gadget console can get.
CONFIG_USB_U_SERIAL=y
CONFIG_U_SERIAL_CONSOLE=y

# Linux bridge (br0 joins eth0 + the USB gadget's usb0 ethernet function)
# for the network requirement: USB-attached hosts must reach eth0 clients
# (and dnsmasq's DHCP) via plain L2 bridging, no NAT/routing involved.
# Built in rather than left as the default module: br0 is assembled at
# boot by systemd-networkd (see rootfs-overlay/etc/systemd/network/
# 15-br0.netdev) before udev's usual alias-triggered module autoload would
# otherwise kick in for it, so this avoids a race instead of depending on
# that timing working out.
CONFIG_BRIDGE=y
