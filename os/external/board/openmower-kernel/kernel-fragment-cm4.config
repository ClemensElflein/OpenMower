# CM4/bcm2711-specific addendum to kernel-fragment-common.config.
#
# Distinct release string so this kernel's /lib/modules/<release>/ tree
# never collides with the CM5 satellite build's when both get merged into
# the one unified rootfs (see external/board/openmower/post-build.sh) --
# also lets a booted kernel's own `uname -r` naturally select the right
# module tree at runtime, with no custom lookup logic needed anywhere.
CONFIG_LOCALVERSION="-cm4"
