#
# When editing in the web interface:
# 1. Click "Edit"
# 2. An editor appears below this one
# 3. Edit the .env file
# 4. Save and Restart the Container
#
# DO NOT EDIT THIS FILE!
#
# Doesn't include the open_mower_ros service itself: that stack runs on the
# host via systemd-nspawn instead (see openmower.service), not in Docker --
# it shares the host's network namespace (nspawn's default), so it reaches
# Mosquitto below the same way it would from the host: localhost:1883.
services:
  # MQTT broker for OpenMower
  Mosquitto:
    image: eclipse-mosquitto:2
    container_name: Mosquitto
    restart: unless-stopped
    user: mosquitto:mosquitto
    ports:
      - "1883:1883"
      - "9001:9001"
    volumes:
      - ./mosquitto.conf:/mosquitto/config/mosquitto.conf:ro

  # OpenMowerApp bundled with nginx
  OpenMowerApp:
    image: ghcr.io/clemenselflein/openmowerapp:latest
    container_name: OpenMowerApp
    restart: unless-stopped
    ports:
      - "8080:8080"

# Dockge-specific extras shown in the UI
x-dockge:
  urls:
  - http://${HOSTNAME}:8080
