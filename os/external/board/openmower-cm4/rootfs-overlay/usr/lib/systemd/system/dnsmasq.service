[Unit]
Description=DHCP server for the internal CM4-xCore link (172.16.78.0/24)
# br0, not eth0 directly -- see /etc/dnsmasq.conf's own comment. br0 is
# created by systemd-networkd (15-br0.netdev) rather than existing from
# boot the way eth0 does, but it still gets its own udev device unit like
# any other netdev the instant it's created, so this dependency form still
# applies unchanged.
After=systemd-networkd.service sys-subsystem-net-devices-br0.device
Requires=sys-subsystem-net-devices-br0.device

[Service]
Type=simple
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/etc/dnsmasq.conf --no-resolv --no-hosts
Restart=on-failure
RestartSec=5
# Defense in depth alongside bind-dynamic (see dnsmasq.conf): don't let a
# burst of early-boot restarts permanently lock this out via systemd's
# default rate limit (5 failures/10s) -- give it real headroom to actually
# converge instead of going to "failed" and staying there until a manual
# restart or reboot.
StartLimitIntervalSec=300
StartLimitBurst=20

[Install]
WantedBy=multi-user.target
