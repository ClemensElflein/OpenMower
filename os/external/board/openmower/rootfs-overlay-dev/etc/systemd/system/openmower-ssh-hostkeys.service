[Unit]
Description=Generate persistent SSH host key on /data (dev image only)
DefaultDependencies=no
ConditionPathExists=!/data/ssh/ssh_host_ed25519_key
RequiresMountsFor=/data
After=data.mount
Before=sshd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/openmower-gen-ssh-hostkeys

[Install]
WantedBy=sysinit.target
