#!/bin/sh
# Dev image only. /etc/ssh is on the read-only squashfs root, so the host key
# has to live on /data instead — generated once, then reused across reboots
# (as long as /data survives) so CLion/ssh don't see a different host key
# every time.
set -eu

KEY=/data/ssh/ssh_host_ed25519_key

mkdir -p /data/ssh
if [ ! -f "$KEY" ]; then
    ssh-keygen -q -t ed25519 -N "" -f "$KEY"
fi
