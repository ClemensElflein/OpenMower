# Dev-image-only services (CLion remote-dev tooling). Numbered after
# 40-openmower.preset so the prod preset doesn't need to know about dev-only
# units, and before 80-buildroot.preset's catch-all.
enable openmower-ssh-hostkeys.service
enable sshd.service

# Console on the default UART header pins (GPIO14/15, mini-UART/ttyS0) --
# dev image only, see post-image.sh (adds console=ttyS0,115200 to
# cmdline.txt for this variant) and config.txt's enable_uart=1 comment for
# why prod leaves this port alone (real hardware wired there, not a debug
# terminal). `enable` on a template instance like this one is NOT
# sufficient by itself -- `systemctl preset-all --root=...` (what
# Buildroot runs at build time) only sees unit files already on disk, and
# there's no serial-getty@ttyS0.service file, only the bare template --
# confirmed silently no-oping on real hardware for the ttyGS0 equivalent
# in the shared preset (see that file's own comment). Actual enablement
# is the baked symlink at
# etc/systemd/system/getty.target.wants/serial-getty@ttyS0.service in
# this same rootfs-overlay-dev. Left here too as a no-cost second attempt
# in case `systemctl preset-all` is ever re-run against an installed
# system.
enable serial-getty@ttyS0.service
