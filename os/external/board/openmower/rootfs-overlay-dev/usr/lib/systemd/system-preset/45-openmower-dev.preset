# Dev-image-only services (CLion remote-dev tooling). Numbered after
# 40-openmower.preset so the prod preset doesn't need to know about dev-only
# units, and before 80-buildroot.preset's catch-all.
enable openmower-ssh-hostkeys.service
enable sshd.service

# Console on the default UART header pins (GPIO14/15, mini-UART/ttyS0) --
# dev image only, see post-image.sh and config.txt's enable_uart=1 comment
# for why prod leaves this port alone (real hardware wired there, not a
# debug terminal). Same "enable on a template instance is a no-op under
# preset-all" story as 40-openmower.preset's ttyGS0 line -- real
# enablement is the baked symlink at
# getty.target.wants/serial-getty@ttyS0.service in this overlay; kept
# here too as a harmless second attempt.
enable serial-getty@ttyS0.service
