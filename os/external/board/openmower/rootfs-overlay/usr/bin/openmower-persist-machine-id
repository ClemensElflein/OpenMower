#!/bin/sh
# Keep the per-device identity on the writable data partition. The rootfs slots
# are squashfs images and cannot hold a machine-id themselves.
set -eu

MACHINE_ID=/data/.openmower-os/machine-id

# Own mkdir -p, not the shared tmpfiles.d dir declaration: this unit has
# DefaultDependencies=no and only orders after data.mount (not
# systemd-tmpfiles-setup.service), specifically to run as early as
# possible -- so .openmower-os may not exist yet when this runs.
mkdir -p "$(dirname "$MACHINE_ID")"

if [ ! -s "$MACHINE_ID" ]; then
    # PID 1 has already created a valid transient ID for this first boot.
    # Persist that exact value so all later DHCP clients use the same identity.
    cat /etc/machine-id > "$MACHINE_ID"
    chmod 0444 "$MACHINE_ID"
fi

# PID 1 itself stacks a transient tmpfs over /etc/machine-id very early in
# boot whenever the baked file starts out empty and /etc is still read-only
# (unconditional systemd behavior -- see systemd-machine-id-commit.service(8)
# -- and our baked /etc/machine-id is deliberately empty, see post-build.sh).
# Bind-mounting ours on top without clearing that first just stacks on top of
# it, leaving the old tmpfs mount orphaned-but-still-listed in the mount
# table for the rest of boot. Harmless on its own, but busybox df's
# find_mount_point() re-stat()s each mount table entry's path live rather
# than trusting its recorded fields, so once our bind-mount is up it matches
# that stale early entry's device (now indistinguishable from /data's) for
# completely unrelated queries like `df /data` -- confirmed against busybox's
# own source. No-ops harmlessly on this script's second invocation (from
# openmower-etc-overlay.service, re-asserting after the /etc overlay mount
# shadows this one): nothing else is stacked here at that point.
if mountpoint -q /etc/machine-id; then
    umount /etc/machine-id
fi

# Make the persistent ID the one exposed to services started after this unit,
# including systemd-networkd.
mount --bind "$MACHINE_ID" /etc/machine-id
