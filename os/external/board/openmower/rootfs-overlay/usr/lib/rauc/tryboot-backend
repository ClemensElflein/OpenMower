#!/bin/sh
# RAUC custom bootloader backend for the Raspberry Pi tryboot mechanism.
#
# The firmware reads autoboot.txt from the first FAT partition (p1):
#   [all]      boot_partition=<primary>     - normal boots
#   [tryboot]  boot_partition=<other>       - one-shot, selected by rebooting
#                                             with the "tryboot" reboot argument
#
# Slot A = boot partition 2, slot B = boot partition 3.
#
# Update flow:
#   set-primary <new>   -> point [tryboot] at the new slot, remember it as
#                          pending; [all] keeps the current (known-good) slot,
#                          so any reset before commit falls back automatically.
#   set-state <new> good (from rauc-mark-good on the first successful boot of
#                          the new slot) -> commit: [all]=<new>, [tryboot]=<old>.
#
# The commit decision in set-state deliberately does NOT rely on the
# "pending" marker written by set-primary: set-primary runs pre-reboot under
# the OLD slot's copy of this script, set-state runs post-reboot under the
# NEW slot's copy, and an OTA update that changes STATE_DIR (as happened
# once already) or the pending-file format silently breaks that handshake --
# new slot boots fine via the firmware's one-shot [tryboot], but the commit
# never happens, so the next plain reboot falls back to [all]. Instead,
# set-state derives the same answer from state that's always read fresh by
# whichever script version is currently running: we only ever boot a
# non-primary slot via [tryboot], so booted-but-not-primary == commit-worthy,
# no memory of a prior install step required. "pending" is kept only for
# get-primary's informational status output.
set -eu

CONFIG_DEV=/dev/mmcblk0p1
MNT=/run/openmower/autoboot
STATE_DIR=/data/.openmower-os/rauc

part_of() {
    case "$1" in
        A) echo 2 ;;
        B) echo 3 ;;
        *) echo "tryboot-backend: invalid slot '$1'" >&2; exit 1 ;;
    esac
}
other_of() {
    case "$1" in
        A) echo B ;;
        B) echo A ;;
        *) echo "tryboot-backend: invalid slot '$1'" >&2; exit 1 ;;
    esac
}

booted_slot() {
    sed -n 's/.*rauc\.slot=\([AB]\).*/\1/p' /proc/cmdline
}

mount_cfg() {
    mkdir -p "$MNT"
    mountpoint -q "$MNT" || mount -t vfat "$CONFIG_DEV" "$MNT"
}

# rauc-mark-good.timer fires unconditionally every boot, independent of
# whatever else might be calling into this same script (an OTA's
# set-primary) around the same time -- both go through mount_cfg()'s
# non-atomic mount-check and write_autoboot()'s fixed-name temp file on the
# same FAT partition. mkdir is atomic even on vfat, so it doubles as a
# cheap cross-process lock; a build-time symlink to flock isn't guaranteed
# present.
LOCK_DIR=/run/openmower/autoboot.lock

acquire_lock() {
    mkdir -p /run/openmower
    n=0
    while ! mkdir "$LOCK_DIR" 2>/dev/null; do
        n=$((n + 1))
        if [ "$n" -ge 10 ]; then
            echo "tryboot-backend: timed out waiting for the autoboot lock" >&2
            exit 1
        fi
        sleep 1
    done
}

release_lock() {
    rmdir "$LOCK_DIR" 2>/dev/null || true
}

cleanup() {
    mountpoint -q "$MNT" 2>/dev/null && umount "$MNT" || true
    release_lock
}
trap cleanup EXIT

read_primary() {
    mount_cfg
    awk -F= '/^\[/{s=$0} s=="[all]" && $1=="boot_partition"{print $2}' \
        "$MNT/autoboot.txt" | tr -d ' \r'
}

# write_autoboot <primary_slot> <tryboot_slot>
write_autoboot() {
    mount_cfg
    cat > "$MNT/autoboot.txt.new" <<EOF
[all]
tryboot_a_b=1
boot_partition=$(part_of "$1")
[tryboot]
boot_partition=$(part_of "$2")
EOF
    mv "$MNT/autoboot.txt.new" "$MNT/autoboot.txt"
    sync
}

primary_slot() {
    case "$(read_primary)" in
        2) echo A ;;
        3) echo B ;;
        *) echo "unknown primary boot_partition" >&2; exit 1 ;;
    esac
}

mkdir -p "$STATE_DIR"
acquire_lock

case "$1" in
    get-primary)
        # While an update is pending, report the slot we intend to boot.
        if [ -f "$STATE_DIR/pending" ]; then
            cat "$STATE_DIR/pending"
        else
            primary_slot
        fi
        ;;
    set-primary)
        SLOT="$2"
        if [ "$SLOT" = "$(booted_slot)" ]; then
            # Making the currently running slot primary: commit immediately.
            write_autoboot "$SLOT" "$(other_of "$SLOT")"
            rm -f "$STATE_DIR/pending"
        else
            # Stage: keep current primary, arm [tryboot] with the new slot.
            write_autoboot "$(primary_slot)" "$SLOT"
            printf '%s\n' "$SLOT" > "$STATE_DIR/pending"
        fi
        ;;
    get-state)
        SLOT="$2"
        cat "$STATE_DIR/state-$SLOT" 2>/dev/null || echo good
        ;;
    set-state)
        SLOT="$2"
        STATE="$3"
        printf '%s\n' "$STATE" > "$STATE_DIR/state-$SLOT"
        if [ "$STATE" = "good" ] && [ "$(booted_slot)" = "$SLOT" ] && [ "$SLOT" != "$(primary_slot)" ]; then
            write_autoboot "$SLOT" "$(other_of "$SLOT")"
            rm -f "$STATE_DIR/pending"
        elif [ "$STATE" = "bad" ] && [ "$(cat "$STATE_DIR/pending" 2>/dev/null)" = "$SLOT" ]; then
            rm -f "$STATE_DIR/pending"
        fi
        ;;
    *)
        echo "unsupported operation: $1" >&2
        exit 1
        ;;
esac
