[Unit]
Description=Grow the data partition to fill the real disk
RequiresMountsFor=/data
# Not load-bearing (the script is idempotent/safe to run after either),
# just lets the very first boot's docker pulls / OTA staging see the full
# grown size immediately instead of only after a reboot.
Before=docker.service multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/openmower-expand-data

[Install]
WantedBy=multi-user.target
