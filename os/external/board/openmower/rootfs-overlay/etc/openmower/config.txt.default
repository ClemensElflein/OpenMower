# OpenMower OS boot config -- unified image, Raspberry Pi CM4 (BCM2711) +
# CM5 (BCM2712), headless.
#
# Don't edit this file -- it's overwritten wholesale on every OS update. To
# change a setting (antenna, UART, fan, ...), edit /data/boot/usercfg.txt
# instead (see its own comments); anything set there overrides this file.
#
# kernel=/device_tree=/start_file=/fixup_file= are set EXPLICITLY per board
# below, not left unset for firmware auto-detect -- auto-detect (by SoC,
# omitting these entirely) is real, documented Raspberry Pi firmware
# behavior, but depends on the specific pinned firmware blob version
# actually supporting it (buildroot/package/rpi-firmware.mk's own pin,
# not something this project controls) -- confirmed the hard way on real
# CM4 hardware that assuming it silently doesn't work is not safe. Model
# filter sections ([cm4]/[pi4]/[cm5]) are the same long-standing,
# well-proven mechanism already used in usercfg.txt.default for antenna/fan
# -- applies to any directive, not just dtparam/dtoverlay.
#
# CM4/[pi4] values are exactly what this image shipped before CM5 support
# (byte-for-byte, just moved under a filter instead of being unconditional)
# -- known-good on real hardware, not re-derived. CM5 is untested on real
# hardware -- best-effort explicit pin, may need revisiting.
[cm4]
kernel=kernel8.img
device_tree=bcm2711-rpi-cm4.dtb
start_file=start4.elf
fixup_file=fixup4.dat

[pi4]
kernel=kernel8.img
device_tree=bcm2711-rpi-4-b.dtb
start_file=start4.elf
fixup_file=fixup4.dat

[cm5]
kernel=kernel_2712.img
device_tree=bcm2712-rpi-cm5-cm4io.dtb

[all]
arm_64bit=1

# Headless: minimal GPU memory, no rainbow splash
gpu_mem=16
disable_splash=1

# USB0 dual-role (OTG): behind a hardware mux on this carrier board that
# routes it to either an external (device) or internal (host) connector.
# USB_OTG_ID (CM4 edge connector pin 101, same pin the official CM4 IO
# board breaks out) is wired through to the mux's cable-detect output, so
# dwc2's own OTG ID-pin comparator sees it directly -- host/device
# switching on a Connector ID Status Change is then handled entirely by
# dwc2 itself in hardware/kernel (drivers/usb/dwc2/hcd.c:
# dwc2_conn_id_status_change(), fired from the CONIDSTSCHNG IRQ), no
# software role switch or userspace cable-detect polling needed at all --
# the stock overlay already supports everything required here. Not a
# usercfg.txt setting -- required for the USB gadget to work at all, not a
# user-facing preference like antenna/UART/fan.
dtoverlay=dwc2,dr_mode=otg
