# OpenMower OS: local Raspberry Pi firmware config overrides (antenna
# selection, fan, etc.). Lives on /data, so unlike config.txt it survives
# OS updates -- edit it here.
#
# UART setup is NOT here -- it's fixed hardware topology (which UARTs
# exist and what GPIO14/15 is used for differs per board), not a user
# preference, so it's baked directly into config.txt.default instead
# (see that file's own [cm4]/[pi4]/[cm5] sections). Deliberate: this file
# ships verbatim as the live, user-editable /data/boot/usercfg.txt, and
# because config.txt's `include usercfg.txt` comes last (later directives
# win), anything set here would silently override that per-board
# restriction the moment a user (or a stale copy of this file) touched it.
#
# Edit this file, then reboot for a change to take effect.
#
## For more options and information see
## https://www.raspberrypi.com/documentation/computers/config_txt.html
## For device filters (the [all]/[pi4]/[cm4]/[cm5] sections below) see
## https://www.raspberrypi.com/documentation/computers/config_txt.html#model-filters

[pi4]
## Enable DRM VC4 V3D driver on top of the dispmanx display stack
#dtoverlay=vc4-fkms-v3d
#max_framebuffers=2
## Do not use more than 256Mb on Pi Model 4, it uses its own Management.
#gpu_mem=256

[cm4]
## CM4 Wi-Fi antenna selection
# Internal/on-module antenna (default):
dtparam=ant1
# External U.FL/IPEX antenna connector:
#dtparam=ant2

## CM4 IO board fan control (GPIO18, starts at 70C) -- enabled by default.
## Harmless if your carrier board doesn't have one wired (just an unused
## GPIO toggling under load).
dtoverlay=pwm-gpio-fan,fan_gpio=18,temp=70000

[cm5]
## CM5 Wi-Fi antenna selection
# Internal/on-module antenna (default):
dtparam=ant1
# External U.FL/IPEX antenna connector:
#dtparam=ant2

## CM5 IO board fan control (GPIO18, starts at 70C) -- enabled by default.
## Harmless if your carrier board doesn't have one wired (just an unused
## GPIO toggling under load).
dtoverlay=pwm-gpio-fan,fan_gpio=18,temp=70000
