# systemd's own 99-default.link renames the onboard ethernet via udev's
# ID_NET_NAME_ONBOARD heuristic (observed: eth0 -> end0), breaking every
# eth0-hardcoded file in this tree. Sorts before it (10 < 99) to win
# instead: keep the kernel's own raw name. wlan0 is unaffected either way
# -- the onboard-index heuristic only targets platform/PCI-bus devices,
# not the SDIO wifi chip.

[Match]
OriginalName=*

[Link]
NamePolicy=kernel
