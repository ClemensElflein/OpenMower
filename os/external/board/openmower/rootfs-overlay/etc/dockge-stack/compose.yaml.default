# Upstream compose.yaml (github.com/louislam/dockge, master) with
# DOCKGE_ENABLE_CONSOLE=false added -- ttyd (see /etc/webterminal-stack)
# already covers in-browser console access. See README before bumping the
# pinned image tag.
#
# /opt/stacks and /opt/dockge are symlinks into /data (see post-build.sh);
# host path must equal container path below (Dockge's own requirement).
# data/ (Dockge's SQLite DB) ships pre-seeded fleet-wide (auth disabled,
# one shared jwtSecret) -- see tmpfiles.d/docker-stacks.conf and README's
# "Known trade-offs".
services:
  dockge:
    image: louislam/dockge:1
    restart: unless-stopped
    ports:
      # Host Port : Container Port
      - 5001:5001
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - ./data:/app/data

      # Stacks Directory
      # READ IT CAREFULLY. If you did it wrong, your data could end up writing into a WRONG PATH.
      # 1. FULL path only. No relative path (MUST)
      # 2. Left Stacks Path === Right Stacks Path (MUST)
      - /opt/stacks:/opt/stacks
    environment:
      # Tell Dockge where is your stacks directory
      - DOCKGE_STACKS_DIR=/opt/stacks
      - DOCKGE_ENABLE_CONSOLE=false
    labels:
      openmower.ui: "true"
      openmower.ui.name: "Dockge"
      openmower.ui.port: "5001"
      openmower.ui.icon: "Dashboard"
      openmower.ui.description: "Container manager"
      openmower.ui.priority: "10"
