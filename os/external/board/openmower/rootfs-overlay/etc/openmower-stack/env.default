#
# Config for the auxiliary Docker stack (Mosquitto + OpenMowerApp).
#
# This is NOT where open_mower_ros itself is configured -- that stack runs
# via systemd-nspawn and reads /data/openmower/openmower.conf instead (see
# README's "Configuration" section).
#
# HOSTNAME only feeds the link Dockge displays for this stack in its UI --
# it doesn't drive anything else, and isn't kept in sync automatically, so
# update it by hand here if your device's actual hostname changes.
HOSTNAME="openmower.local"
